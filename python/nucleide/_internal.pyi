    @property
    def n_inactive(self) -> int: ...
    @property
    def vars_per_cycle(self) -> int: ...
    @property
    def k_col(self) -> list[float]: ...
    @property
    def k_abs(self) -> list[float]: ...
    @property
    def k_path(self) -> list[float]: ...
    @property
    def prompt_life_col(self) -> list[float]: ...
    @property
    def prompt_life_path(self) -> list[float]: ...
    @property
    def averages(self) -> list[dict[str, float]]: ...

@final
class SurfSrc:
    """Parsed MCNP SSW surface-source file."""
    @property
    def kod(self) -> str: ...
    @property
    def ver(self) -> str: ...
    @property
    def np1(self) -> int: ...
    @property
    def nrss(self) -> int: ...
    @property
    def ncrd(self) -> int: ...
    @property
    def njsw(self) -> int: ...
    @property
    def niss(self) -> int: ...
