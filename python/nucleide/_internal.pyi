from collections.abc import Sequence
from typing import Any, final

@final
class Nuclide:
    """A nuclide identifier with naming-convention conversions."""

    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def nucid(self) -> int: ...
    @property
    def zzaaam(self) -> int: ...
    @property
    def z(self) -> int: ...
    @property
    def a(self) -> int: ...
    @property
    def state(self) -> int: ...
    @property
    def zaid(self) -> int: ...
    @property
    def zzllaaam(self) -> str: ...
    @property
    def serpent(self) -> str: ...
    @property
    def nist(self) -> str: ...
    @property
    def cinder(self) -> int: ...
    @property
    def alara(self) -> str: ...
    @property
    def sza(self) -> int: ...
    @property
    def mass(self) -> float | None: ...
    @property
    def abundance(self) -> float | None: ...
    def fluka(self) -> str: ...

@final
class Particle:
    """A particle species with cross-code name translations."""

    def __init__(self, spec: str | int) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def describe(self) -> str: ...
    def mcnp(self) -> str | None: ...
    def mcnp6(self) -> str | None: ...
    def fluka(self) -> str | None: ...
    def geant4(self) -> str | None: ...

@final
class XsdirTable:
    """One xsdir directory entry."""
    @property
    def name(self) -> str: ...
    @property
    def awr(self) -> float: ...
    @property
    def filename(self) -> str: ...
    @property
    def filetype(self) -> int: ...
    @property
    def address(self) -> int: ...
    @property
    def tablelength(self) -> int: ...
    @property
    def temperature(self) -> float | None: ...
    @property
    def ptable(self) -> bool: ...
    def zaid(self) -> str: ...
    def to_serpent(self, directory: str = "") -> str: ...

@final
class Xsdir:
    """Parsed MCNP xsdir cross-section index."""
    @property
    def datapath(self) -> str | None: ...
    @property
    def awr(self) -> dict[int, float]: ...
    @property
    def tables(self) -> list[XsdirTable]: ...
    def find_table(self, name: str) -> list[XsdirTable]: ...
    def nucs(self) -> list[int]: ...

@final
class MeshTally:
    """One fmesh4 tally from a meshtal file."""
    @property
    def tally_number(self) -> int: ...
    @property
    def particle(self) -> str: ...
    @property
    def dose_response(self) -> bool: ...
    @property
    def x_bounds(self) -> list[float]: ...
    @property
    def y_bounds(self) -> list[float]: ...
    @property
    def z_bounds(self) -> list[float]: ...
    @property
    def e_bounds(self) -> list[float]: ...
    @property
    def result(self) -> list[list[float]]: ...
    @property
    def rel_error(self) -> list[list[float]]: ...
    @property
    def total_result(self) -> list[float]: ...
    def dims(self) -> tuple[int, int, int]: ...
    def num_ves(self) -> int: ...
    def num_e_groups(self) -> int: ...
    def cell(self, i: int, j: int, k: int) -> tuple[list[float], list[float]]: ...
    def cell_total(self, i: int, j: int, k: int) -> tuple[float, float]: ...

@final
class Meshtal:
    """Parsed MCNP meshtal file."""
    @property
    def version(self) -> str: ...
    @property
    def ld(self) -> str: ...
    @property
    def title(self) -> str: ...
    @property
    def histories(self) -> int: ...
    @property
    def tallies(self) -> dict[int, MeshTally]: ...

@final
class Wwinp:
    """Parsed MCNP WWINP weight-window file (Cartesian)."""
    @property
    def ni(self) -> int: ...
    @property
    def nr(self) -> int: ...
    @property
    def ne(self) -> list[int]: ...
    @property
    def nf(self) -> tuple[int, int, int]: ...
    @property
    def origin(self) -> tuple[float, float, float]: ...
    @property
    def nc(self) -> tuple[int, int, int]: ...
    @property
    def cm(self) -> list[list[float]]: ...
    @property
    def bounds(self) -> list[list[float]]: ...
    @property
    def e(self) -> list[list[float]]: ...
    def ww_row(self, particle: int, group: int) -> list[float]: ...
    def ww_column(self, particle: int, ve: int) -> list[float]: ...

@final
class Mctal:
    """Parsed MCNP MCTAL kcode data (upstream subset)."""
    @property
