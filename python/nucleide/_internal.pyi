@final
class AliasTable:
    """Walker alias table for discrete sampling."""
    def __init__(self, pdf: list[float]) -> None: ...
    def sample(self, r1: float, r2: float) -> int: ...
    @property
    def pdf(self) -> list[float]: ...
    def __len__(self) -> int: ...

@final
class MeshSourceSampler:
    """Mesh source sampler over a meshtal tally (analog/uniform/user)."""
    def __init__(
        self, tally: MeshTally, mode: str, user_pdf: list[float] | None = None
    ) -> None: ...
    def sample(self, r1: float, r2: float) -> dict[str, float]: ...

@final
class PtracFile:
    """Parsed MCNP PTRAC event file."""
    @property
    def problem_title(self) -> str: ...
    @property
    def width_code(self) -> int: ...
    @property
    def variable_nums(self) -> dict[str, int]: ...
    def events(self) -> list[dict[str, float]]: ...

def from_zaid(zaid: int) -> Nuclide: ...
