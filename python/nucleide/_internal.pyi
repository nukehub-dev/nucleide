@final
class Chain:
    """Parsed depletion chain (XML format)."""
    @property
    def nuclides(self) -> list[str]: ...
    def index_of(self, name: str) -> int | None: ...

@final
class Cascade:
    """Enrichment cascade with numeric multicomponent solving."""
    @staticmethod
    def default_uranium() -> Cascade: ...
    def solve(self, tolerance: float | None = None, max_iterations: int | None = None) -> None: ...
    @property
    def swu_per_feed(self) -> float: ...
    @property
    def swu_per_prod(self) -> float: ...
    @property
    def x_prod_j(self) -> float: ...
    @property
    def x_tail_j(self) -> float: ...
    def separative_work_per_product(self) -> float: ...

@final
class MaterialsCompendium:
    """PNNL/DOE Materials Compendium (411 named materials)."""
    @staticmethod
    def load(path: str) -> MaterialsCompendium: ...
    def __len__(self) -> int: ...
    def names(self) -> list[str]: ...
    def get(self, name: str, as_material: bool = False) -> dict[str, Any] | None: ...

