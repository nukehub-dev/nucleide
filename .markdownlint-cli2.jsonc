{
  // Nucleide markdown lint configuration.
  "config": {
    "default": true,
    "first-line-heading": {
      "front_matter_title": "^\\s*title\\s*:"
    },
    "line-length": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "no-inline-html": false,
    "no-bare-urls": false
  },
  "gitignore": true
}
